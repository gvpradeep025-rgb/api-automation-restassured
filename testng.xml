<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Restful Booker API Suite">
    <listeners>
        <listener class-name="com.pradeep.api.listeners.ExtentReportListener"/>
    </listeners>
    <test name="API Regression">
        <classes>
            <class name="com.pradeep.api.tests.HealthCheckTest"/>
            <class name="com.pradeep.api.tests.AuthTest"/>
            <class name="com.pradeep.api.tests.BookingCrudTest"/>
            <class name="com.pradeep.api.tests.BookingDataDrivenTest"/>
            <class name="com.pradeep.api.tests.BookingNegativeTest"/>
            <class name="com.pradeep.api.tests.BookingFilterTest"/>
        </classes>
    </test>
</suite>
